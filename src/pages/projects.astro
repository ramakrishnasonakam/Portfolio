---
import Base from '../layouts/Base.astro';
import { getProjects } from '../lib/projects.js';
import { SITE } from '../lib/config.js';

const projects = await getProjects();

function fmt(d) {
  if (!d) return '';
  return new Date(d).toLocaleDateString('en-US', {
    year: 'numeric', month: 'short',
  });
}
---
<Base title="Projects">
  <header class="grid grid-cols-12 gap-x-4 mb-20 rise">
    <div class="col-span-12 sm:col-span-2 font-mono text-[10px] uppercase tracking-[0.22em] text-muted pt-3">
      § 03 / Projects
    </div>
    <h1 class="col-span-12 sm:col-span-10 font-sans font-bold text-ink leading-none tracking-tightest text-[clamp(2.5rem,6vw,4.5rem)]">
      Builds<span class="text-signal">.</span>
    </h1>
    <div class="col-span-12 sm:col-span-2"></div>
    <p class="col-span-12 sm:col-span-7 font-sans text-lg text-body leading-snug max-w-2xl mt-6">
      Selected work, pulled live from
      <a href={`https://github.com/${SITE.githubHandle}`} target="_blank" rel="noopener" class="link text-ink">
        GitHub
      </a>.
    </p>
  </header>

  {projects.length === 0 ? (
    <p class="text-muted italic max-w-xl">
      No projects yet, or the repo names in
      <code class="font-mono text-xs bg-rule px-1.5 py-0.5 mx-1">FEATURED_PROJECTS</code>
      don't match any public repo on
      <code class="font-mono text-xs bg-rule px-1.5 py-0.5 mx-1">github.com/{SITE.githubHandle}</code>.
    </p>
  ) : (
    <ul>
      {projects.map((p, i) => (
        <li class="border-b border-rule">
          <a href={p.url} target="_blank" rel="noopener" class="row block py-10 px-4 -mx-4">
            <div class="grid grid-cols-12 gap-x-4 items-baseline">
              <div class="col-span-2 font-mono text-[10px] uppercase tracking-[0.22em] muted-on-hover text-muted">
                {String(i + 1).padStart(2, '0')}
              </div>
              <div class="col-span-7">
                <div class="flex items-baseline gap-3 mb-2 font-mono text-[10px] uppercase tracking-[0.22em] muted-on-hover text-muted">
                  {p.language && <span>{p.language}</span>}
                  {p.stars > 0 && <span>· ★ {p.stars}</span>}
                  {p.homepage && <span class="signal-on-hover text-signal">· Live ↗</span>}
                </div>
                <h2 class="font-sans font-semibold text-3xl sm:text-4xl tracking-tighter leading-snug font-mono">
                  {p.name}
                </h2>
                {p.description && (
                  <p class="mt-4 text-[15px] leading-relaxed max-w-xl muted-on-hover text-body font-sans">
                    {p.description}
                  </p>
                )}
                {p.topics.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-x-3 font-mono text-[10px] uppercase tracking-[0.18em] muted-on-hover text-muted">
                    {p.topics.slice(0, 5).map((t) => <span>#{t}</span>)}
                  </div>
                )}
              </div>
              <div class="col-span-3 text-right font-mono text-[10px] uppercase tracking-[0.18em] muted-on-hover text-muted">
                {fmt(p.updated)}
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>
  )}
</Base>
