---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/config.js';
---
<Base title="About" description={SITE.bio}>
  <header class="grid grid-cols-12 gap-x-4 mb-16 rise">
    <div class="col-span-12 sm:col-span-2 font-mono text-[10px] uppercase tracking-[0.22em] text-muted pt-3">
      § 04 / About
    </div>
    <h1 class="col-span-12 sm:col-span-10 font-sans font-bold text-ink leading-none tracking-tightest text-[clamp(2.5rem,6vw,4.5rem)]">
      {SITE.name}<span class="text-signal">.</span>
    </h1>
  </header>

  <article class="grid grid-cols-12 gap-x-4 gap-y-16">
    <div class="col-span-12 sm:col-span-2 font-mono text-[10px] uppercase tracking-[0.22em] text-muted">
      Bio
    </div>
    <div class="col-span-12 sm:col-span-7 font-sans text-[18px] leading-[1.7] text-body space-y-5">
      {SITE.bio.split(/\n\n+/).map((p) => <p>{p}</p>)}
    </div>

    <div class="col-span-12 sm:col-span-2 font-mono text-[10px] uppercase tracking-[0.22em] text-muted">
      Reach
    </div>
    <ul class="col-span-12 sm:col-span-7 space-y-3 font-mono text-[12px]">
      {SITE.email && (
        <li class="grid grid-cols-12 gap-4 items-baseline border-b border-rule pb-2">
          <span class="col-span-3 uppercase tracking-[0.18em] text-muted">Email</span>
          <a href={`mailto:${SITE.email}`} class="col-span-9 text-ink link">{SITE.email}</a>
        </li>
      )}
      <li class="grid grid-cols-12 gap-4 items-baseline border-b border-rule pb-2">
        <span class="col-span-3 uppercase tracking-[0.18em] text-muted">Substack</span>
        <a
          href={SITE.substackUrl || `https://${SITE.substackHandle}.substack.com`}
          target="_blank" rel="noopener"
          class="col-span-9 text-ink link break-all"
        >
          {SITE.substackUrl || `${SITE.substackHandle}.substack.com`}
        </a>
      </li>
      <li class="grid grid-cols-12 gap-4 items-baseline border-b border-rule pb-2">
        <span class="col-span-3 uppercase tracking-[0.18em] text-muted">GitHub</span>
        <a href={`https://github.com/${SITE.githubHandle}`} target="_blank" rel="noopener" class="col-span-9 text-ink link break-all">
          github.com/{SITE.githubHandle}
        </a>
      </li>
      {SITE.twitter && (
        <li class="grid grid-cols-12 gap-4 items-baseline border-b border-rule pb-2">
          <span class="col-span-3 uppercase tracking-[0.18em] text-muted">Twitter</span>
          <a href={`https://twitter.com/${SITE.twitter}`} target="_blank" rel="noopener" class="col-span-9 text-ink link">@{SITE.twitter}</a>
        </li>
      )}
      {SITE.linkedin && (
        <li class="grid grid-cols-12 gap-4 items-baseline border-b border-rule pb-2">
          <span class="col-span-3 uppercase tracking-[0.18em] text-muted">LinkedIn</span>
          <a href={`https://linkedin.com/in/${SITE.linkedin}`} target="_blank" rel="noopener" class="col-span-9 text-ink link">linkedin.com/in/{SITE.linkedin}</a>
        </li>
      )}
      <li class="grid grid-cols-12 gap-4 items-baseline border-b border-rule pb-2">
        <span class="col-span-3 uppercase tracking-[0.18em] text-muted">Based</span>
        <span class="col-span-9 text-ink">{SITE.location}</span>
      </li>
    </ul>
  </article>
</Base>
