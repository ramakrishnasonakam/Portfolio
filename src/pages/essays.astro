---
import Base from '../layouts/Base.astro';
import { getEssays } from '../lib/essays.js';
import { SUBSTACK_BASE } from '../lib/config.js';

const essays = await getEssays();

function fmt(d) {
  if (!d) return '';
  return new Date(d).toLocaleDateString('en-US', {
    year: 'numeric', month: 'long', day: 'numeric',
  });
}
---
<Base title="Essays">
  <header class="grid grid-cols-12 gap-x-4 mb-20 rise">
    <div class="col-span-12 sm:col-span-2 font-mono text-[10px] uppercase tracking-[0.22em] text-muted pt-3">
      § 02 / Essays
    </div>
    <h1 class="col-span-12 sm:col-span-10 font-sans font-bold text-ink leading-none tracking-tightest text-[clamp(2.5rem,6vw,4.5rem)]">
      Writing<span class="text-signal">.</span>
    </h1>
    <div class="col-span-12 sm:col-span-2"></div>
    <p class="col-span-12 sm:col-span-7 font-sans text-lg text-body leading-snug max-w-2xl mt-6">
      Live from <a href={SUBSTACK_BASE} target="_blank" rel="noopener" class="link text-ink">Substack</a>.
      Newest first.
    </p>
  </header>

  {essays.length === 0 ? (
    <p class="text-muted italic max-w-xl">
      No essays yet — or the Substack handle hasn't been set in
      <code class="font-mono text-xs bg-rule px-1.5 py-0.5 mx-1">src/lib/config.js</code>.
    </p>
  ) : (
    <ul>
      {essays.map((essay, i) => (
        <li class="border-b border-rule">
          <a href={essay.url} target="_blank" rel="noopener" class="row block py-10 px-4 -mx-4">
            <div class="grid grid-cols-12 gap-x-4 items-baseline">
              <div class="col-span-2 font-mono text-[10px] uppercase tracking-[0.22em] muted-on-hover text-muted">
                {String(i + 1).padStart(2, '0')}
              </div>
              <div class="col-span-7">
                <div class="font-mono text-[10px] uppercase tracking-[0.22em] mb-2 muted-on-hover text-muted">
                  {essay.readingTime} min read
                </div>
                <h2 class="font-sans font-semibold text-3xl sm:text-4xl tracking-tighter leading-snug">
                  {essay.title}
                </h2>
                {essay.description && (
                  <p class="mt-4 text-[15px] leading-relaxed max-w-xl muted-on-hover text-body">
                    {essay.description}…
                  </p>
                )}
              </div>
              <div class="col-span-3 text-right font-mono text-[10px] uppercase tracking-[0.18em] muted-on-hover text-muted">
                {fmt(essay.date)}
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>
  )}
</Base>
