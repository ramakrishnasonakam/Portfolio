---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/config.js';
import { getEssays } from '../lib/essays.js';
import { getProjects } from '../lib/projects.js';

const essays = await getEssays();
const projects = await getProjects();

const feed = [
  ...essays.map((e) => ({
    kind: 'essay', title: e.title, url: e.url,
    description: e.description, date: e.date,
    meta: `${e.readingTime} min read`,
  })),
  ...projects.map((p) => ({
    kind: 'project', title: p.name, url: p.url,
    description: p.description, date: p.updated,
    meta: [p.language, p.stars > 0 ? `★ ${p.stars}` : null].filter(Boolean).join(' · '),
  })),
].sort((a, b) => new Date(b.date) - new Date(a.date));

function fmt(d) {
  if (!d) return '';
  return new Date(d).toLocaleDateString('en-US', {
    year: 'numeric', month: 'short', day: 'numeric',
  });
}
---
<Base>
  <!-- ╔═══ HERO ═══╗  asymmetric 12-col grid -->
  <section class="grid grid-cols-12 gap-x-4 gap-y-10 mb-28 sm:mb-40 rise">
    <!-- index label -->
    <div class="col-span-12 sm:col-span-2 font-mono text-[10px] uppercase tracking-[0.22em] text-muted pt-3">
      § 00 / Index
    </div>

    <!-- giant tagline -->
    <h1 class="col-span-12 sm:col-span-10 font-sans font-bold text-ink leading-none tracking-tightest text-[clamp(2.5rem,7vw,5.5rem)]">
      {SITE.tagline.split('.').slice(0, 1).join('.')}<span class="text-signal">.</span>
    </h1>

    <div class="col-span-12 sm:col-span-2"></div>
    <p class="col-span-12 sm:col-span-7 font-sans text-lg sm:text-xl text-body leading-snug max-w-2xl mt-2">
      {SITE.tagline.split('.').slice(1).join('.').trim()}
    </p>

    <!-- nav cues -->
    <div class="col-span-12 sm:col-span-2"></div>
    <div class="col-span-12 sm:col-span-10 flex flex-wrap gap-x-8 gap-y-2 font-mono text-[11px] uppercase tracking-[0.18em] mt-4">
      <a href="/essays" class="link text-ink">Read essays →</a>
      <a href="/projects" class="link text-ink">See projects →</a>
      <a href="/about" class="link text-muted hover:text-ink transition-colors">About</a>
    </div>
  </section>

  <!-- ╔═══ FEED ═══╗ -->
  <section>
    <header class="grid grid-cols-12 gap-x-4 mb-8 items-end border-b border-ink pb-3">
      <div class="col-span-2 font-mono text-[10px] uppercase tracking-[0.22em] text-muted">
        § 01
      </div>
      <h2 class="col-span-7 font-sans font-bold text-2xl text-ink tracking-tightest">
        Recently
      </h2>
      <div class="col-span-3 text-right font-mono text-[10px] uppercase tracking-[0.18em] text-muted">
        {feed.length} items
      </div>
    </header>

    {feed.length === 0 ? (
      <p class="text-muted italic max-w-xl mt-6">
        Nothing here yet. Once <code class="font-mono text-xs bg-rule px-1.5 py-0.5">substackHandle</code>
        and <code class="font-mono text-xs bg-rule px-1.5 py-0.5">FEATURED_PROJECTS</code> are set in
        <code class="font-mono text-xs bg-rule px-1.5 py-0.5">src/lib/config.js</code>, content appears here.
      </p>
    ) : (
      <ul>
        {feed.map((item, i) => (
          <li class="border-b border-rule">
            <a
              href={item.url}
              target={item.url.startsWith('http') ? '_blank' : null}
              rel={item.url.startsWith('http') ? 'noopener' : null}
              class="row block py-8 px-4 -mx-4"
            >
              <div class="grid grid-cols-12 gap-x-4 items-baseline">
                <div class="col-span-2 font-mono text-[10px] uppercase tracking-[0.22em] muted-on-hover text-muted">
                  {String(i + 1).padStart(2, '0')}
                </div>
                <div class="col-span-7">
                  <div class="flex items-baseline gap-3 mb-2">
                    <span class={`font-mono text-[10px] uppercase tracking-[0.22em] signal-on-hover ${
                      item.kind === 'essay' ? 'text-signal' : 'text-ink'
                    }`}>
                      {item.kind === 'essay' ? 'Essay' : 'Project'}
                    </span>
                    {item.meta && (
                      <span class="font-mono text-[10px] uppercase tracking-[0.18em] muted-on-hover text-muted">
                        {item.meta}
                      </span>
                    )}
                  </div>
                  <h3 class="font-sans font-semibold text-2xl sm:text-3xl tracking-tighter leading-snug">
                    {item.title}
                  </h3>
                  {item.description && (
                    <p class="mt-3 text-[15px] leading-relaxed max-w-xl muted-on-hover text-body">
                      {item.description}
                    </p>
                  )}
                </div>
                <div class="col-span-3 text-right font-mono text-[10px] uppercase tracking-[0.18em] muted-on-hover text-muted">
                  {fmt(item.date)}
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
