---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SITE, HANDLES, SUBSTACK_BASE, MEDIUM_BASE } from '../lib/config.js';
import { getEssays } from '../lib/essays.js';
import { getProjects } from '../lib/projects.js';

const essays = await getEssays();
const projects = await getProjects();

function fmt(d) {
  if (!d) return '';
  return new Date(d).toLocaleDateString('en-US', {
    year: 'numeric', month: 'short', day: 'numeric',
  });
}
---
<Base>
  <span id="top"></span>

  <!-- ═══════════════════ HERO ═══════════════════ -->
  <section class="min-h-[92vh] flex flex-col justify-center py-32 rise">

    <!-- Tiny eyebrow — coordinates, no greeting -->
    <div class="eyebrow flex items-center gap-3 mb-12">
      <span class="inline-block w-10 h-px bg-gold/60"></span>
      <span>MMXXVI / Portfolio</span>
    </div>

    <!-- Name. Massive. Display serif. Italic accent letter. -->
    <h1 class="font-display text-ivory leading-[0.95] tracking-tightest font-light text-[clamp(3.5rem,11vw,9rem)] max-w-6xl">
      {SITE.name}
    </h1>

    <!-- Roles. The whole bio. -->
    <div class="mt-12 max-w-3xl">
      <ul class="flex flex-wrap items-center gap-x-6 gap-y-3 font-display italic text-bone text-[clamp(1.5rem,3vw,2.25rem)] font-light">
        {SITE.roles.map((role, i) => (
          <>
            {i > 0 && <li class="text-gold/60 font-sans not-italic text-sm">◆</li>}
            <li class={i === 0 || i === 3 ? 'text-ivory' : 'text-bone'}>{role}</li>
          </>
        ))}
      </ul>
    </div>

    <!-- Scroll cue. Restrained. -->
    <div class="mt-32 eyebrow flex items-center gap-3 text-smoke">
      <span>Scroll</span>
      <Icon name="chevronDown" size={14} class="animate-pulse" />
    </div>
  </section>


  <!-- ═══════════════════ § 01 — WORK ═══════════════════ -->
  <section id="work" class="py-32 sm:py-40 border-t border-veil/30">

    <header class="grid grid-cols-12 gap-x-4 items-end mb-16">
      <div class="col-span-12 sm:col-span-8">
        <p class="eyebrow mb-4">§ 01 — Work</p>
        <h2 class="font-display text-ivory text-5xl sm:text-6xl tracking-tightest font-light leading-none">
          What I build<span class="text-gold">.</span>
        </h2>
      </div>
      <div class="col-span-12 sm:col-span-4 sm:text-right mt-6 sm:mt-0">
        <a
          href={`https://github.com/${HANDLES.github}`}
          target="_blank" rel="noopener"
          class="inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-regal text-bone link"
        >
          Full archive <Icon name="arrowUpRight" size={12} />
        </a>
      </div>
    </header>

    {projects.length === 0 ? (
      <p class="text-smoke italic max-w-xl">
        No projects available — GitHub couldn't be reached, or the handle in
        <code class="font-mono text-xs bg-obsidian px-1.5 py-0.5 mx-1 text-bone">src/lib/config.js</code>
        isn't set.
      </p>
    ) : (
      <ul class="space-y-px">
        {projects.map((p, i) => (
          <li>
            <a
              href={p.url}
              target="_blank"
              rel="noopener"
              class="card group block p-7 sm:p-10"
            >
              <div class="grid grid-cols-12 gap-x-4 gap-y-3 items-baseline">
                <!-- Index -->
                <div class="col-span-2 sm:col-span-1 font-mono text-[10px] uppercase tracking-regal text-gold/70">
                  {String(i + 1).padStart(2, '0')}
                </div>

                <!-- Title + description -->
                <div class="col-span-10 sm:col-span-8">
                  <h3 class="font-display font-light text-3xl sm:text-4xl text-ivory tracking-tighter group-hover:text-gold transition-colors duration-500">
                    {p.name}
                  </h3>

                  {p.description ? (
                    <p class="mt-3 text-bone text-[15px] leading-relaxed max-w-2xl">
                      {p.description}
                    </p>
                  ) : (
                    <p class="mt-3 text-smoke italic text-[14px] max-w-2xl">
                      No description yet — add one to this repo's README or GitHub description field.
                    </p>
                  )}

                  <!-- Metadata row -->
                  <div class="mt-5 flex items-center gap-5 flex-wrap font-mono text-[10px] uppercase tracking-regal text-smoke">
                    {p.language && (
                      <span class="inline-flex items-center gap-2">
                        <span class="w-1.5 h-1.5 bg-gold rounded-full"></span>
                        {p.language}
                      </span>
                    )}
                    {p.stars > 0 && (
                      <span class="inline-flex items-center gap-1.5">
                        <Icon name="star" size={10} /> {p.stars}
                      </span>
                    )}
                    <span>{fmt(p.updated)}</span>
                  </div>
                </div>

                <!-- Right column: badge + arrow -->
                <div class="col-span-12 sm:col-span-3 sm:text-right flex sm:flex-col sm:items-end items-center gap-3 sm:gap-4 mt-2 sm:mt-0">
                  {p.badge && (
                    <span class="inline-block border border-gold/60 text-gold font-mono text-[10px] uppercase tracking-regal px-3 py-1.5">
                      {p.badge}
                    </span>
                  )}
                  <Icon name="arrowUpRight" size={20} class="text-smoke group-hover:text-gold transition-colors duration-500" />
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>


  <!-- ═══════════════════ § 02 — WRITING ═══════════════════ -->
  <section id="writing" class="py-32 sm:py-40 border-t border-veil/30">

    <header class="grid grid-cols-12 gap-x-4 items-end mb-16">
      <div class="col-span-12 sm:col-span-8">
        <p class="eyebrow mb-4">§ 02 — Writing</p>
        <h2 class="font-display text-ivory text-5xl sm:text-6xl tracking-tightest font-light leading-none">
          What I publish<span class="text-gold">.</span>
        </h2>
      </div>
      <div class="col-span-12 sm:col-span-4 sm:text-right mt-6 sm:mt-0">
        <div class="flex sm:justify-end gap-5 font-mono text-[10px] uppercase tracking-regal text-bone">
          <a href={SUBSTACK_BASE} target="_blank" rel="noopener" class="link">Substack</a>
          <a href={MEDIUM_BASE} target="_blank" rel="noopener" class="link">Medium</a>
        </div>
      </div>
    </header>

    {essays.length === 0 ? (
      <p class="text-smoke italic max-w-xl">
        No essays yet — or the handles in
        <code class="font-mono text-xs bg-obsidian px-1.5 py-0.5 mx-1 text-bone">src/lib/config.js</code>
        aren't set.
      </p>
    ) : (
      <ul class="divide-y divide-veil/30 border-y border-veil/30">
        {essays.map((essay, i) => (
          <li>
            <a
              href={essay.url}
              target="_blank"
              rel="noopener"
              class="group block py-10 px-4 -mx-4 grid grid-cols-12 gap-x-4 items-baseline transition-colors duration-500 hover:bg-obsidian/60"
            >
              <span class="col-span-2 sm:col-span-1 font-mono text-[10px] uppercase tracking-regal text-gold/70">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="col-span-10 sm:col-span-8">
                <div class="flex items-baseline gap-3 mb-3">
                  <span class="font-mono text-[9px] uppercase tracking-regal text-gold/80 border border-gold/40 px-2 py-0.5">
                    {essay.source}
                  </span>
                </div>
                <h3 class="font-display font-light text-3xl sm:text-4xl text-ivory tracking-tighter leading-tight group-hover:text-gold transition-colors duration-500">
                  {essay.title}
                </h3>
                {essay.subtitle && (
                  <p class="mt-3 font-display italic text-bone text-[16px] leading-snug max-w-2xl">
                    {essay.subtitle}
                  </p>
                )}
              </div>
              <div class="hidden sm:block col-span-3 text-right font-mono text-[10px] uppercase tracking-regal text-smoke">
                {fmt(essay.date)}
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>


  <!-- ═══════════════════ FOOTER ═══════════════════ -->
  <footer id="contact" class="py-24 border-t border-veil/30">
    <div class="grid grid-cols-12 gap-6 items-end">
      <div class="col-span-12 sm:col-span-7">
        <p class="eyebrow mb-4">Contact</p>
        <p class="font-display text-ivory text-4xl sm:text-5xl tracking-tightest font-light leading-tight">
          Speak<span class="text-gold">.</span>
        </p>
      </div>

      <div class="col-span-12 sm:col-span-5 sm:justify-self-end">
        <ul class="flex items-center gap-4">
          <li>
            <a
              href={`mailto:${HANDLES.email}`}
              aria-label="Email"
              class="icon-btn"
            >
              <Icon name="mail" size={18} />
            </a>
          </li>
          {HANDLES.linkedin && (
            <li>
              <a
                href={`https://linkedin.com/in/${HANDLES.linkedin}`}
                target="_blank" rel="noopener"
                aria-label="LinkedIn"
                class="icon-btn"
              >
                <Icon name="linkedin" size={18} />
              </a>
            </li>
          )}
          <li>
            <a
              href={`https://github.com/${HANDLES.github}`}
              target="_blank" rel="noopener"
              aria-label="GitHub"
              class="icon-btn"
            >
              <Icon name="github" size={18} />
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Hairline rule + copyright -->
    <div class="mt-16 pt-8 border-t border-veil/30 flex items-center justify-between gap-4 flex-wrap font-mono text-[10px] uppercase tracking-regal text-smoke">
      <span>© {new Date().getFullYear()} {SITE.name}</span>
      <a href="#top" class="hover:text-gold transition-colors duration-500">↑ Top</a>
    </div>
  </footer>

</Base>
