---
import '../styles/global.css';
import { SITE, HANDLES } from '../lib/config.js';

const { title, description } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.name}` : SITE.name;
const pageDesc = description || SITE.tagline;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={pageDesc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <!-- ─── STICKY NAV (subtle) ─── -->
    <nav class="sticky top-0 z-40 bg-bg/80 backdrop-blur-md border-b border-rule">
      <div class="mx-auto max-w-[1180px] px-6 sm:px-10 lg:px-14 py-4 flex items-baseline justify-between gap-6">
        <a href="#top" class="font-display text-lg text-ink tracking-tighter font-medium">
          {SITE.name}
        </a>
        <ul class="flex items-baseline gap-6 sm:gap-8 font-mono text-[11px] uppercase tracking-[0.18em]">
          <li><a href="#projects" class="text-grey hover:text-ink transition-colors">Projects</a></li>
          <li><a href="#essays" class="text-grey hover:text-ink transition-colors">Essays</a></li>
          <li><a href="#contact" class="text-grey hover:text-ink transition-colors">Contact</a></li>
        </ul>
      </div>
    </nav>

    <div class="mx-auto max-w-[1180px] px-6 sm:px-10 lg:px-14">
      <slot />
    </div>
  </body>
</html>
