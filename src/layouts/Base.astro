---
import '../styles/global.css';
import { SITE } from '../lib/config.js';

const { title, description } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.name}` : SITE.name;
const pageDesc = description || SITE.roles.join(' · ');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={pageDesc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#000000" />
    <title>{pageTitle}</title>
  </head>
  <body class="vignette">

    <!-- Sticky nav: minimal, monogram + 3 anchors + resume action -->
    <nav class="sticky top-0 z-40 bg-void/70 backdrop-blur-sm border-b border-veil/30">
      <div class="mx-auto max-w-[1200px] px-6 sm:px-10 lg:px-16 py-5 flex items-center justify-between gap-6">
        <a href="#top" class="font-display text-gold text-lg tracking-tighter font-medium italic">
          {SITE.name.split(' ').map((w) => w[0]).join('')}
        </a>
        <ul class="flex items-center gap-5 sm:gap-8 font-mono text-[10px] uppercase tracking-regal text-bone">
          <li><a href="#work" class="hover:text-gold transition-colors duration-500">Work</a></li>
          <li><a href="#writing" class="hover:text-gold transition-colors duration-500">Writing</a></li>
          <li><a href="#contact" class="hover:text-gold transition-colors duration-500">Contact</a></li>
          <li>
            <a
              href="/resume.pdf"
              target="_blank"
              rel="noopener"
              class="inline-block border border-gold/60 text-gold px-3 py-1.5 hover:bg-gold hover:text-void transition-all duration-500"
            >
              Resume
            </a>
          </li>
        </ul>
      </div>
    </nav>

    <div class="mx-auto max-w-[1200px] px-6 sm:px-10 lg:px-16">
      <slot />
    </div>
  </body>
</html>
